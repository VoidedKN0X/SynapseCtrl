<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Talking to your own Synapse servers (and nothing else). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Fingerprint unlock for the app lock (framework BiometricManager/BiometricPrompt). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Notifications from the background checks; asked for only when you turn them on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ntfy, the only push app SynapseCtrl uses (UnifiedPush), to wake the background check. -->
    <queries>
        <package android:name="io.heckel.ntfy" />
        <intent>
            <action android:name="org.unifiedpush.android.distributor.REGISTER" />
        </intent>
    </queries>

    <application
        android:name=".SynapseCtrlApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SynapseCtrl">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Push from ntfy: the push address and wake-up messages. Exported because ntfy is another app;
             every broadcast must carry the secret token of SynapseCtrl's registration or it's ignored. A message
             only starts the background check; its content is never used. -->
        <receiver
            android:name=".data.notify.PushReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.TEMP_UNAVAILABLE" />
            </intent-filter>
        </receiver>
        <!-- ntfy binds to this for a few seconds before delivering a message, so SynapseCtrl can check at once.
             It does nothing else. -->
        <service
            android:name=".data.notify.RaiseToForegroundService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.RAISE_TO_FOREGROUND" />
            </intent-filter>
        </service>

        <!-- Home screen widget: the active server online or not, active users and open reports. -->
        <receiver
            android:name=".ui.widgets.StatusWidget"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_status_info" />
        </receiver>

        <!-- WorkManager's diagnostics receiver (debug dumps over adb) isn't needed; leave it out. -->
        <receiver
            android:name="androidx.work.impl.diagnostics.DiagnosticsReceiver"
            tools:node="remove" />

        <!-- Don't let androidx.emoji2 look up a downloadable emoji font at start-up: emoji are drawn with the
             phone's own emoji font, and nothing is fetched. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
